---
import GitHubRelease from "../components/GitHubRelease.astro";
import SiteLayout from "../layouts/SiteLayout.astro";

const releases = [
	{
		repo: "svgforge/svgforge",
		description:
			"Low-level Node.js module — takes a bunch of SVG files, optimizes and bakes them into SVG sprites.",
	},
	{
		repo: "svgforge/svgforge-cli",
		description: "Command line interface for svgforge.",
	},
	{
		repo: "svgforge/icon-library",
		description:
			"A Wordpress plugin for managing SVG icons. You can upload your generated SVG sprite and use it in Gutenberg editor.",
	},
];
---

<SiteLayout title="Releases" description="Latest releases of the svgforge projects.">
	<h1>Releases</h1>
	{releases.map((item) => {
		const [owner, name] = item.repo.split('/');
		const repoUrl = `https://github.com/${item.repo}`;
		return (
			<article class="post">
				<div class="post__meta">{owner}</div>
				<h2 class="post__title"><a href={repoUrl}>{name}</a></h2>
				<p class="post__desc">{item.description}</p>
				<GitHubRelease repo={item.repo} />
			</article>
		);
	})}
</SiteLayout>
