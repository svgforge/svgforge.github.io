---
import GitHubRelease from "../components/GitHubRelease.astro";
import SiteLayout from "../layouts/SiteLayout.astro";

const repos = [
	"svgforge/svgforge",
	"svgforge/svgforge-cli",
	"svgforge/sf-icon-manager",
];

async function getRepoDescription(repo: string): Promise<string> {
	try {
		const res = await fetch(`https://api.github.com/repos/${repo}`, {
			headers: { Accept: "application/vnd.github.v3+json" },
		});
		if (!res.ok) return "";
		const data: { description?: string | null } = await res.json();
		return data.description ?? "";
	} catch {
		return "";
	}
}

const releases = await Promise.all(
	repos.map(async (repo) => ({
		repo,
		description: await getRepoDescription(repo),
	})),
);
---

<SiteLayout title="Releases" description="Latest releases of the svgforge projects.">
	<h1>Releases</h1>
	{releases.map((item) => {
		const [owner, name] = item.repo.split('/');
		const repoUrl = `https://github.com/${item.repo}`;
		return (
			<article class="post">
				<div class="post__meta">{owner}</div>
				<h2 class="post__title"><a href={repoUrl}>{name}</a></h2>
				{item.description && <p class="post__desc">{item.description}</p>}
				<GitHubRelease repo={item.repo} />
			</article>
		);
	})}
</SiteLayout>
